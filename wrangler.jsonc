{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "liverail",
    "compatibility_date": "2026-02-12",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": "@tanstack/react-start/server-entry",
    "kv_namespaces": [
        { "binding": "RTT_TOKEN_CACHE" }
    ],
    "observability": {
        "enabled": false,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true,
            "invocation_logs": true
        },
        "traces": {
            "enabled": false,
            "persist": true,
            "head_sampling_rate": 1
        }
    }
}
